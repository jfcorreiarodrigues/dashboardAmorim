{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.1.0/schema.json",
  "name": "p2v3",
  "position": {
    "x": 440,
    "y": 328,
    "z": 3000,
    "width": 390,
    "height": 248,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Facts_Market"
                    }
                  },
                  "Property": "Ano"
                }
              },
              "queryRef": "Facts_Market.Ano",
              "nativeQueryRef": "Ano",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_SubSegmento"
                    }
                  },
                  "Property": "SubSegmento"
                }
              },
              "queryRef": "Dim_SubSegmento.SubSegmento",
              "nativeQueryRef": "SubSegmento"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Facts_Market"
                    }
                  },
                  "Property": "Valor Mercado"
                }
              },
              "queryRef": "Facts_Market.Valor Mercado",
              "nativeQueryRef": "Valor Mercado",
              "displayName": "Pipeline ($bn)"
            }
          ]
        }
      }
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "axisType": {
              "expr": {
                "Literal": {
                  "Value": "'Categorical'"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Healthcare — recorde resiliente: $12,9bn (2015) → $50bn (2018) → $93bn+$24bn (2026)'"
                }
              }
            }
          }
        }
      ],
      "visualHeader": [
        {
          "properties": {
            "showTooltipButton": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "visualHeaderTooltip": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Pipeline healthcare em $bn: inpatient 79M sqft/$93bn (recorde) + outpatient 34M sqft/$24bn em 2026; starts Q1-26 $48bn; ~3.800 projetos. Dados em sqft e $, não em nº de projetos (unidade nativa dos trackers). Fonte: JLL, CBRE, RevistaMed (healthcare RE trackers), 2026.'"
                }
              }
            }
          }
        }
      ]
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "fHCMetrica",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Metrica"
              }
            },
            "Property": "Métrica"
          }
        },
        "type": "Categorical",
        "howCreated": "User",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "t",
              "Entity": "Dim_Metrica",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "t"
                          }
                        },
                        "Property": "Métrica"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "'Pipeline saúde — valor'"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
