table Dim_Calendario
	lineageTag: bae9b386-08d5-5e3d-b55b-68c458941e6f
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: General Date
		lineageTag: c4a99ffd-086b-566a-bcdc-7817213d3847
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: cc9aa721-3484-503a-88e1-08ef7c892d14
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column MesNum
		dataType: int64
		formatString: 0
		lineageTag: 96f2fcd2-fae1-51ca-b2c6-ce0ec2573f33
		summarizeBy: none
		isNameInferred
		sourceColumn: [MesNum]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: 89fcdaf9-2103-59ae-a409-8088eaa43b4c
		summarizeBy: none
		sortByColumn: MesNum
		isNameInferred
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: 5c743e91-9307-5602-87ac-c067d0336225
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column AnoMes
		dataType: string
		lineageTag: 7d28ad3e-5590-5457-9cbc-ff459627a377
		summarizeBy: none
		isNameInferred
		sourceColumn: [AnoMes]

		annotation SummarizationSetBy = Automatic

	partition Dim_Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(1987,1,1), DATE(2031,12,31)),
				    "Ano", YEAR([Date]),
				    "MesNum", MONTH([Date]),
				    "Mes", FORMAT([Date], "mmm"),
				    "Trimestre", "Q" & QUARTER([Date]),
				    "AnoMes", FORMAT([Date], "yyyy-mm")
				)

	annotation PBI_ResultType = Table
