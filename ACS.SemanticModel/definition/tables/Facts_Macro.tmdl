table Facts_Macro
	lineageTag: c46722b5-de5a-5ec9-91a0-32214435faea

	measure 'Indicador Macro' = AVERAGE(Facts_Macro[Valor])
		formatString: #,0.00
		lineageTag: 7da675f8-2cf3-5ae2-9dac-12465711059b

	measure 'Indicador Atual' =
			VAR UltimaData = CALCULATE(MAX(Facts_Macro[Data]))
			RETURN CALCULATE(AVERAGE(Facts_Macro[Valor]), Facts_Macro[Data] = UltimaData)
		formatString: #,0.00
		lineageTag: a6c959f8-8abf-5252-8d70-81a7c210d29c

	measure 'Spread Credito-Fed (pp)' =
			VAR Mort = CALCULATE([Indicador Atual], Dim_Indicador[IndicadorID] = "IND_MORT30")
			VAR Fed = CALCULATE([Indicador Atual], Dim_Indicador[IndicadorID] = "IND_FEDFUNDS")
			RETURN Mort - Fed
		formatString: #,0.00
		lineageTag: ba7f0f83-b563-5ad1-8293-2bfac9782579

	measure 'Housing Starts (mil, SAAR)' = CALCULATE(AVERAGE(Facts_Macro[Valor]), Dim_Indicador[Indicador] = "Housing Starts")
		formatString: #,0
		lineageTag: 698fa5b6-faae-5edc-86d6-270e594e262a

	measure 'Taxa Credito 30a (%)' = CALCULATE(AVERAGE(Facts_Macro[Valor]), Dim_Indicador[Indicador] = "Taxa crédito habitação 30 anos")
		formatString: 0.00
		lineageTag: ceaef24f-f6cc-50c5-9159-bb65744dad11

	measure 'Importacoes Cortica ($M)' = CALCULATE(SUM(Facts_Macro[Valor]), Dim_Indicador[IndicadorID] = "IND_CORK")
		formatString: #,0
		lineageTag: 292a7d33-7c2e-5d36-a915-c437f88c5f7a

	column ID
		dataType: string
		lineageTag: 9d554b0e-568c-5940-b4ae-10da8f278181
		summarizeBy: none
		sourceColumn: ID

		annotation SummarizationSetBy = Automatic

	column Data
		dataType: dateTime
		lineageTag: e61a4176-b062-5ad9-a41f-3cb29851bc47
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 6940ed0c-b5af-5c60-946f-879c3c6933df
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

	column IndicadorID
		dataType: string
		lineageTag: 0f9f5a9f-27a8-5a3f-9c56-edb6abeee4e2
		summarizeBy: none
		sourceColumn: IndicadorID

		annotation SummarizationSetBy = Automatic

	column Valor
		dataType: double
		lineageTag: 21e46580-9a80-59a3-963b-0bc28d5152bc
		summarizeBy: none
		sourceColumn: Valor

		annotation SummarizationSetBy = Automatic

	column Unidade
		dataType: string
