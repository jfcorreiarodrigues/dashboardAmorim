	column FonteID
		dataType: string
		lineageTag: f7284198-8721-57c0-9434-3ebea46c9999
		summarizeBy: none
		sourceColumn: FonteID

		annotation SummarizationSetBy = Automatic

	partition Facts_Macro = m
		mode: import
		source =
				let
				    Origem = Excel.Workbook(File.Contents(CaminhoExcel), null, true),
				    Folha = Origem{[Item="Facts_Macro",Kind="Sheet"]}[Data],
				    CabecalhosPromovidos = Table.PromoteHeaders(Folha, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos,{{"ID", type text}, {"Data", type datetime}, {"Ano", Int64.Type}, {"IndicadorID", type text}, {"Valor", type number}, {"Unidade", type text}, {"FonteID", type text}})
				in
				    TiposAlterados

	annotation PBI_ResultType = Table
