table Facts_PermitsState
	lineageTag: bc5877db-c613-593f-a3f3-99d676622796

	measure 'Permits (milhares)' = SUM(Facts_PermitsState[Unidades_milhares])
		formatString: #,0.0
		lineageTag: 8aa92e5d-c416-5b95-9cdf-c3915a60d663

	measure 'Valor Permits ($M)' = SUM(Facts_PermitsState[Valor_USDmilhoes])
		formatString: #,0
		lineageTag: 14809725-110e-56c5-9fd4-b29a058dbc42

	measure 'Preco Medio Unidade ($k)' = DIVIDE([Valor Permits ($M)], [Permits (milhares)])
		formatString: #,0.0
		lineageTag: b415c8c8-fe45-5275-820a-ebe767c36528

	measure 'Permits YoY %' =
			VAR Atual = [Permits (milhares)]
			VAR Anterior = CALCULATE([Permits (milhares)], DATEADD(Dim_Calendario[Date], -1, YEAR))
			RETURN DIVIDE(Atual - Anterior, Anterior)
		formatString: 0.0%
		lineageTag: 2ca69c16-cd02-5243-b662-e7d5d15e6168

	measure 'Quota Estado (%)' = DIVIDE([Permits (milhares)], CALCULATE([Permits (milhares)], REMOVEFILTERS(Dim_Estado)))
		formatString: 0.0%
		lineageTag: fd7bc9ea-b989-58bb-b466-7454ccbf3fd6

	column ID
		dataType: string
