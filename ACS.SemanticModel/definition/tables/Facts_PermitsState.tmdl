	partition Facts_PermitsState = m
		mode: import
		source =
				let
				    Origem = Excel.Workbook(File.Contents(CaminhoExcel), null, true),
				    Folha = Origem{[Item="Facts_PermitsState",Kind="Sheet"]}[Data],
				    CabecalhosPromovidos = Table.PromoteHeaders(Folha, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos,{{"ID", type text}, {"Data", type datetime}, {"Ano", Int64.Type}, {"Estado", type text}, {"Abrev", type text}, {"TipoEstrutura", type text}, {"Unidades_milhares", type number}, {"Valor_USDmilhoes", type number}, {"FonteID", type text}})
				in
				    TiposAlterados

	annotation PBI_ResultType = Table
