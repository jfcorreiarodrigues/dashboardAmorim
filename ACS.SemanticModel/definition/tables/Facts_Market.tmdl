table Facts_Market
	lineageTag: a9ca3093-8fce-5835-954f-953f2c354ec4

	measure 'Valor Mercado' = SUM(Facts_Market[Valor])
		formatString: #,0.00
		lineageTag: ce418c2e-8fb3-5082-89b6-d16d74beec76

	measure 'Quota TAM no Mercado (%)' =
			VAR Tam = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_TAM")
			VAR Total = CALCULATE(MAX(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_DESP")
			RETURN DIVIDE(Tam, Total)
		formatString: 0.0%
		lineageTag: 0ee7fa5c-bbcf-5ecb-9481-bb885ddc458a

	measure 'ABI Meses Abaixo 50' = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[Métrica] = "ABI <50 (duração)")
		formatString: 0" meses"
		lineageTag: 6cd5a207-25a4-5d19-b021-cc999315d34e

	measure 'Dodge Momentum YoY' = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[Métrica] = "Dodge Momentum (crescimento)")
		formatString: +0"%"
		lineageTag: 92b88068-bbbc-5b25-bbcc-cae02e282988

	measure 'Starts Saude ($bn)' = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[Métrica] = "Construction starts", Dim_Segmento[Segmento] = "Saúde")
		formatString: #,0.0
		lineageTag: 70969794-c9ea-5c10-9358-3825cc574977

	measure 'Ocupacao Senior (%)' = CALCULATE(AVERAGE(Facts_Market[Valor]), Dim_Metrica[Métrica] = "Taxa de ocupação", Dim_SubSegmento[SubSegmento] = "Senior Living Premium")
		formatString: 0.0"%"
		lineageTag: fbe6ed46-fc01-508c-9b75-a261ca9d56df

	measure 'KPI Seg 1' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_PIPE_P", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)", Facts_Market[Data] <= TODAY()) VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_PIPE_P", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0", "pt-PT") & " projetos (" & FORMAT(d, "mmm yyyy", "pt-PT") & ")",
			"Saúde", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_STARTS", Dim_SubSegmento[SubSegmento] = "Saúde — total", Facts_Market[Data] <= TODAY()) VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_STARTS", Dim_SubSegmento[SubSegmento] = "Saúde — total", Facts_Market[Data] = d) RETURN "$" & FORMAT(v, "#,0.0", "pt-PT") & "bn (" & FORMAT(YEAR(d), "0") & ")",
			"Residencial de Luxo", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_MKT", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total", Facts_Market[Data] <= TODAY()) VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_MKT", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total", Facts_Market[Data] = d) RETURN "$" & FORMAT(v, "#,0.0", "pt-PT") & "bn (" & FORMAT(YEAR(d), "0") & ")",
			"Adjacente", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_OCC", Dim_SubSegmento[SubSegmento] = "Senior Living Premium", Facts_Market[Data] <= TODAY()) VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_OCC", Dim_SubSegmento[SubSegmento] = "Senior Living Premium", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0.0", "pt-PT") & "% (" & FORMAT(d, "mmm yyyy", "pt-PT") & ")",
			BLANK())
		lineageTag: 030a6112-f4e4-5a8c-bb31-0f312ab8b672

	measure 'KPI Seg 2' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_PIPE_Q", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)", Facts_Market[Data] <= TODAY()) VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_PIPE_Q", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0", "pt-PT") & " quartos (" & FORMAT(d, "mmm yyyy", "pt-PT") & ")",
			"Saúde", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_NOVOS", Dim_SubSegmento[SubSegmento] = "Saúde — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_NOVOS", Dim_SubSegmento[SubSegmento] = "Saúde — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0", "pt-PT") & " hospitais (" & FORMAT(YEAR(d), "0") & ")",
			"Residencial de Luxo", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_CAGR", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_CAGR", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0.0", "pt-PT") & "%/ano até 2031",
			"Adjacente", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_DEFICE", Dim_SubSegmento[SubSegmento] = "Senior Living Premium") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_DEFICE", Dim_SubSegmento[SubSegmento] = "Senior Living Premium", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0", "pt-PT") & " unidades (" & FORMAT(YEAR(d), "0") & ")",
			BLANK())
		lineageTag: baa79326-137d-5306-9077-3c862f1a70db

	measure 'KPI Seg 3' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_ABRE_P", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_ABRE_P", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0", "pt-PT") & " hotéis (" & FORMAT(YEAR(d), "0") & ")",
			"Saúde", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_RENOV", Dim_SubSegmento[SubSegmento] = "Saúde — total") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_RENOV", Dim_SubSegmento[SubSegmento] = "Saúde — total", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0", "pt-PT") & "% do capex (" & FORMAT(YEAR(d), "0") & ")",
			"Residencial de Luxo", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_PRICE_SF", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_PRICE_SF", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total", Facts_Market[Data] = d) RETURN "$" & FORMAT(v, "#,0", "pt-PT") & "/sqft",
			"Adjacente", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_RENDA", Dim_SubSegmento[SubSegmento] = "Senior Living Premium", Facts_Market[Data] <= TODAY()) VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_RENDA", Dim_SubSegmento[SubSegmento] = "Senior Living Premium", Facts_Market[Data] = d) RETURN "$" & FORMAT(v, "#,0", "pt-PT") & "/mês (" & FORMAT(d, "mmm yyyy", "pt-PT") & ")",
			BLANK())
		lineageTag: d3eb49ce-2896-5387-8601-2e1ed2ff55c7

	measure 'KPI Seg 4' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_DESP", Dim_SubSegmento[SubSegmento] = "Hotelaria — total") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_DESP", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Facts_Market[Data] = d) RETURN "$" & FORMAT(v, "#,0", "pt-PT") & "bn/ano (" & FORMAT(YEAR(d), "0") & ")",
			"Saúde", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_1BN", Dim_SubSegmento[SubSegmento] = "Saúde — total") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_1BN", Dim_SubSegmento[SubSegmento] = "Saúde — total", Facts_Market[Data] = d) RETURN FORMAT(v, "#,0", "pt-PT") & " projetos (" & FORMAT(YEAR(d), "0") & ")",
			"Residencial de Luxo", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_APPREC", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_APPREC", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total", Facts_Market[Data] = d) RETURN "+" & FORMAT(v, "#,0", "pt-PT") & "% em 5 anos",
			"Adjacente", VAR d = CALCULATE(MAX(Facts_Market[Data]), Dim_Metrica[MetricaID] = "M_TRANS", Dim_SubSegmento[SubSegmento] = "Senior Living Premium") VAR v = CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_TRANS", Dim_SubSegmento[SubSegmento] = "Senior Living Premium", Facts_Market[Data] = d) RETURN "$" & FORMAT(v, "#,0", "pt-PT") & "M (" & FORMAT(YEAR(d), "0") & ")",
			BLANK())
		lineageTag: ab6cfb2b-38a3-5ed3-880a-db1dc081e947

	measure 'KPI Seg 1 Titulo' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", "Pipeline hoteleiro — nacional",
			"Saúde", "Construction starts — saúde",
			"Residencial de Luxo", "Mercado residencial de luxo",
			"Adjacente", "Ocupação senior living premium",
			"Seleciona um segmento")
		lineageTag: 06c0b4d0-7144-5128-a437-81e239ac2b10

