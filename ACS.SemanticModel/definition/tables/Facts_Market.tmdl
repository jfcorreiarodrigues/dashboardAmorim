	measure 'KPI Seg 4 Titulo' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", "Despesa anual de construção",
			"Saúde", "Mega-projetos > $1bn",
