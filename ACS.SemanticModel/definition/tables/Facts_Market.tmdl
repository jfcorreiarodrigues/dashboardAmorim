	measure 'Serie Segmento Temporal' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_PIPE_P", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)"),
			"Saúde", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_STARTS", Dim_SubSegmento[SubSegmento] = "Saúde — total"),
			"Residencial de Luxo", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_MKT", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total"),
			"Adjacente", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_OCC", Dim_SubSegmento[SubSegmento] = "Senior Living Premium"),
			BLANK())
		formatString: #,0.0
		lineageTag: df948943-6ef9-5ffb-8d81-a0d4e2a68c0a

	measure 'Titulo Grafico Temporal' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", "Momentum — pipeline hoteleiro nacional (nº projetos, trimestral)",
			"Saúde", "Construction starts saúde ($bn, 2024-2030 — inclui forecast ConstructConnect)",
			"Residencial de Luxo", "Mercado residencial de luxo ($bn, 2025 → 2031)",
			"Adjacente", "Ocupação Senior Living Premium: 77,8% → 89,5% (procura estrutural)",
			"Seleciona um segmento")
		lineageTag: 20b607a7-54e6-5ea3-bf76-e31fd64aff5b

	measure 'Serie Segmento Anual' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_ABRE_P", Dim_SubSegmento[SubSegmento] = "Hotelaria — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)"),
			"Saúde", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_NOVOS", Dim_SubSegmento[SubSegmento] = "Saúde — total", Dim_Geografia[Cidade/Área] = "Estados Unidos (nacional)"),
			"Residencial de Luxo", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_MKT", Dim_SubSegmento[SubSegmento] = "Residencial luxo — total"),
			"Adjacente", CALCULATE(SUM(Facts_Market[Valor]), Dim_Metrica[MetricaID] = "M_DEFICE", Dim_SubSegmento[SubSegmento] = "Senior Living Premium"),
			BLANK())
		formatString: #,0
		lineageTag: 0c081eb2-2dc4-52cc-b1ff-f52f53bcecc8

	measure 'Titulo Grafico Anual' =
			VAR Seg = SELECTEDVALUE(Dim_Segmento[Segmento], "Residencial de Luxo")
			RETURN SWITCH(Seg,
			"Hotelaria", "Aberturas de hotéis por ano (2022-2027, Lodging Econometrics)",
			"Saúde", "Novos hospitais anunciados (2025, nacional — ConstructConnect)",
			"Residencial de Luxo", "Mercado residencial de luxo por ano ($bn, Mordor)",
			"Adjacente", "Défice de senior housing — 806 mil unidades até 2030 (nº)",
			"Seleciona um segmento")
