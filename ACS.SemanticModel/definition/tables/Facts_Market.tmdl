	partition Facts_Market = m
		mode: import
		source =
				let
				    Origem = Excel.Workbook(File.Contents(CaminhoExcel), null, true),
				    Folha = Origem{[Item="Facts_Market",Kind="Sheet"]}[Data],
				    CabecalhosPromovidos = Table.PromoteHeaders(Folha, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos,{{"ID", type text}, {"Data", type datetime}, {"Ano", Int64.Type}, {"Periodo", type text}, {"SegmentoID", type text}, {"SubSegmentoID", type text}, {"GeografiaID", type text}, {"MetricaID", type text}, {"Valor", type number}, {"Unidade", type text}, {"FonteID", type text}, {"Nota", type text}})
				in
				    TiposAlterados

	annotation PBI_ResultType = Table
