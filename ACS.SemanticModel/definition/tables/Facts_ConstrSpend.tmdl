table Facts_ConstrSpend
	lineageTag: 65ae6c3a-7d24-529e-96a8-5f9c59cd1903

	measure 'Despesa Constr ($M)' = SUM(Facts_ConstrSpend[Valor_USDm])
		formatString: #,0
		lineageTag: 83c3e8cc-c354-5333-b666-21806cfa4350

	measure 'Despesa Constr YoY %' =
			VAR Atual = [Despesa Constr ($M)]
			VAR Anterior = CALCULATE([Despesa Constr ($M)], DATEADD(Dim_Calendario[Date], -1, YEAR))
			RETURN IF(ISBLANK(Atual), BLANK(), DIVIDE(Atual - Anterior, Anterior))
		formatString: 0.0%
		lineageTag: b7ddb530-de0e-5340-a2fa-3cf59ef7e01f

	measure 'Despesa Anual ($M)' =
			VAR vAnual = CALCULATE(SUM(Facts_ConstrSpend[Valor_USDm]), Facts_ConstrSpend[Frequência] = "Anual")
			VAR vMensal =
			    SUMX(
			        SUMMARIZE(Facts_ConstrSpend, Facts_ConstrSpend[CategoriaID], Facts_ConstrSpend[Ano]),
			        CALCULATE(AVERAGE(Facts_ConstrSpend[Valor_USDm]), Facts_ConstrSpend[Frequência] = "Mensal")
			    )
			RETURN vAnual + vMensal
		formatString: #,0
		lineageTag: b2b67a5b-a044-59f7-bd9f-7926d8effea9

	measure 'Quota HHL no Total (%)' =
			VAR Hhl = CALCULATE([Despesa Anual ($M)], Dim_Categoria[Categoria] IN {"Lodging", "Health care", "Residential"})
			VAR Total = CALCULATE([Despesa Anual ($M)], Dim_Categoria[Categoria] = "Total Construction")
			RETURN DIVIDE(Hhl, Total)
		formatString: 0.0%
		lineageTag: 6ba60dad-089d-55af-9c77-d3c900ea7aa1

	column ID
		dataType: string
		lineageTag: f44c1dff-7a4e-51bf-93aa-393bd381f7f0
		summarizeBy: none
		sourceColumn: ID

		annotation SummarizationSetBy = Automatic

	column Data
		dataType: dateTime
		lineageTag: 5667e976-ce2f-5d12-8b8a-5583c2f58edc
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 8691632a-780e-566c-af17-cac98af66db2
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

	column 'Frequência'
		dataType: string
		lineageTag: 2e3647e5-557b-54b8-86b4-8c1ef5a2d3e4
		summarizeBy: none
		sourceColumn: Frequência

		annotation SummarizationSetBy = Automatic

	column CategoriaID
		dataType: string
		lineageTag: 86a0822c-fc8f-55fe-a121-ea9d7bd6cb52
		summarizeBy: none
		sourceColumn: CategoriaID

		annotation SummarizationSetBy = Automatic

	column Valor_USDm
		dataType: int64
